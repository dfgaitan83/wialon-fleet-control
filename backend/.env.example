# Copia este archivo como .env y coloca tus valores reales. El .env NUNCA se sube a GitHub.
# En producción (Render) estas mismas variables se configuran en el panel del servicio.

# --- Ambiente: development | production (production exige HTTPS, PostgreSQL y apaga Swagger) ---
ENVIRONMENT=development

# --- Wialon ---
WIALON_TOKEN=pon_aqui_tu_token_de_wialon
WIALON_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_TIMEOUT_SECONDS=10

# --- Base de datos ---
# Local: SQLite (no requiere instalar nada). Producción: la URL de Neon tal cual
# (postgresql://...?sslmode=require); el backend la adapta a asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./local.db

# --- Autenticación ---
# Mínimo 32 caracteres. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera_un_secreto_aleatorio_de_al_menos_32_caracteres
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10/minute
# true en producción (obligatorio). false solo para desarrollo local sin HTTPS.
COOKIE_SECURE=false

# --- Admin inicial (lo crea: uv run python -m scripts.seed_admin) ---
# Contraseña: mínimo 12 caracteres, con letras y números. Usa un gestor de contraseñas.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia_esto_por_una_clave_robusta_123
ADMIN_FULL_NAME=Administrador

# --- HTTP ---
CORS_ORIGINS=["http://localhost:5173"]
# Swagger en /docs. Vacío = activo en desarrollo y apagado en producción.
DOCS_ENABLED=
